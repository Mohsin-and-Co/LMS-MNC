<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lms_calendar_event_tree" model="ir.ui.view">
        <field name="name">lms.calendar.event.tree</field>
        <field name="model">lms.calendar.event</field>
        <field name="arch" type="xml">
            <list string="Calendar Events" create="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="date"/>
                <field name="event_type"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_lms_calendar_event_form" model="ir.ui.view">
        <field name="name">lms.calendar.event.form</field>
        <field name="model">lms.calendar.event</field>
        <field name="arch" type="xml">
            <form string="Calendar Event">
                <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="date"/>
                                <field name="event_type"/>
                                <field name="country_id" placeholder="All countries"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                        </group>
                    <field name="description" placeholder="Event description shown on LMS Calendar page."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_lms_calendar_event" model="ir.actions.act_window">
        <field name="name">LMS Calendar</field>
        <field name="res_model">lms.calendar.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add academic calendar events.</p>
            <p>These are shown on the LMS portal Calendar page to students.</p>
        </field>
    </record>
    <menuitem id="menu_lms_calendar_event"
              name="LMS Calendar"
              parent="education_school_management.menu_school_management_root"
              action="action_lms_calendar_event"
              sequence="48"/>
</odoo>
