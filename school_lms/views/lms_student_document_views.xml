<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lms_student_document_tree" model="ir.ui.view">
        <field name="name">lms.student.document.tree</field>
        <field name="model">lms.student.document</field>
        <field name="arch" type="xml">
            <list string="Student Documents" create="1">
                <field name="name"/>
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="attachment_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_lms_student_document_form" model="ir.ui.view">
        <field name="name">lms.student.document.form</field>
        <field name="model">lms.student.document</field>
        <field name="arch" type="xml">
            <form string="Student Document">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Document title"/>
                            <field name="student_id" options="{'no_create': False}"/>
                            <field name="subject_id" options="{'no_create': False}"/>
                        </group>
                        <group>
                            <field name="attachment_id"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info mb-0" role="alert">
                        <strong>LMS:</strong> Documents appear under the student's <strong>Upload</strong> page on the LMS. Students can upload their own from LMS; teachers/admins can add documents here for any student.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_lms_student_document" model="ir.actions.act_window">
        <field name="name">Student Documents</field>
        <field name="res_model">lms.student.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Student uploads (documents).</p>
            <p>Students upload from the LMS <strong>Upload</strong> page. Teachers and admins can create documents here for any student; they will appear on that student's LMS Upload list.</p>
        </field>
    </record>
    <menuitem id="menu_lms_student_document"
              name="Student Documents"
              parent="education_school_management.menu_school_management_root"
              action="action_lms_student_document"
              sequence="46"/>
</odoo>
