<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Teacher list View -->
        <record id="view_teacher_list" model="ir.ui.view">
            <field name="name">school.teacher.list</field>
            <field name="model">school.teacher</field>
            <field name="arch" type="xml">
                <list string="Teachers">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="hire_date"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Teacher Form View -->
        <record id="view_teacher_form" model="ir.ui.view">
            <field name="name">school.teacher.form</field>
            <field name="model">school.teacher</field>
            <field name="arch" type="xml">
                <form string="Teacher">
                    <header>
                        <button name="action_print_id_card"
                                string="Print ID Card"
                                type="object"
                                class="oe_highlight"
                                icon="fa-print"/>
                    </header>
                    <sheet>
                       <group>
                            <group>
                                <field name="photo" widget="image" style="max-width: 200px; max-height: 200px;"/>
                            </group>
                            <group>
                                <field name="name"/>
                                <field name="employee_id"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="hire_date"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="subject_ids"/>
                            </group>
                        </group>
                        
                        <group string="QR Code" invisible="not qr_code">
                            <group>
                                <field name="qr_code" readonly="1"/>
                                <field name="qr_code_image" widget="image" readonly="1"/>
                            </group>
                            <group>
                                <field name="qr_code_url" readonly="1" widget="url"/>
                               </group>
                        </group>
                        
                        <notebook>
                            <page string="Attendance History" name="attendance">
                                <field name="attendance_ids" context="{'default_staff_id': id}">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="check_in"/>
                                        <field name="check_out"/>
                                        <field name="status"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Teacher Action -->
        <record id="action_teacher" model="ir.actions.act_window">
            <field name="name">Teachers</field>
            <field name="res_model">school.teacher</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_teacher_root" name="Teachers" parent="menu_school_management_root" sequence="15"/>
        <menuitem id="menu_teacher" name="All Teachers" parent="menu_teacher_root" action="action_teacher" sequence="10"/>

    </data>
</odoo>
