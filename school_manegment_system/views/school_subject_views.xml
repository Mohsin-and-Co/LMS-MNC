<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ========================= -->
        <!-- Subject List View -->
        <!-- ========================= -->
        <record id="view_school_subject_list" model="ir.ui.view">
            <field name="name">school.subject.list</field>
            <field name="model">school.subject</field>
            <field name="arch" type="xml">
                <list string="Subjects">
                    <field name="name"/>
                    <field name="class_id"/>
                    <field name="max_marks"/>
                </list>
            </field>
        </record>

        <!-- ========================= -->
        <!-- Subject Form View -->
        <!-- ========================= -->
        <record id="view_school_subject_form" model="ir.ui.view">
            <field name="name">school.subject.form</field>
            <field name="model">school.subject</field>
            <field name="arch" type="xml">
                <form string="Subject">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="class_id"/>
                            <field name="max_marks"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ========================= -->
        <!-- Subject Action -->
        <!-- ========================= -->
        <record id="action_subject" model="ir.actions.act_window">
            <field name="name">Subjects</field>
            <field name="res_model">school.subject</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click to create your first subject record!
                </p>
            </field>
        </record>

        <!-- ========================= -->
        <!-- Menus -->
        <!-- ========================= -->
        <menuitem id="menu_subject_root" name="Subjects" parent="menu_school_management_root" sequence="30"/>
        <menuitem id="menu_subject" name="All Subjects" parent="menu_subject_root" action="action_subject"
                  sequence="10"/>


    </data>
</odoo>
