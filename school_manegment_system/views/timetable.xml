<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Timetable list View -->
        <record id="view_timetable_list" model="ir.ui.view">
            <field name="name">timetable.list</field>
            <field name="model">school.timetable</field>
            <field name="arch" type="xml">
                <list string="Timetable">
                    <field name="class_id"/>
                    <field name="subject_id"/>
                    <field name="teacher_id"/>
                    <field name="day_of_week"/>
                    <field name="start_time" widget="float_time"/>
                    <field name="end_time" widget="float_time"/>
                    <field name="start_time_display" string="Start Time (AM/PM)"/>
                    <field name="end_time_display" string="End Time (AM/PM)"/>
                </list>
            </field>
        </record>

        <!-- Timetable Form View -->
        <record id="view_timetable_form" model="ir.ui.view">
            <field name="name">timetable.form</field>
            <field name="model">school.timetable</field>
            <field name="arch" type="xml">
                <form string="Timetable">
                    <sheet>
                        <group>
<!--                            <field name="name"/>-->
                            <field name="class_id"/>
                            <field name="subject_id"/>
                            <field name="teacher_id"/>
                            <field name="day_of_week"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                        <group string="Time Display (AM/PM)">
                            <field name="start_time_display" readonly="1"/>
                            <field name="end_time_display" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Timetable Calendar View -->
        <record id="view_timetable_calendar" model="ir.ui.view">
            <field name="name">timetable.calendar</field>
            <field name="model">school.timetable</field>
            <field name="arch" type="xml">
                <calendar string="Class Timetable" date_start="start_time" date_stop="end_time" color="class_id">
                    <field name="name"/>
                    <field name="class_id"/>
                    <field name="teacher_id"/>
                    <field name="subject_id"/>
                    <field name="day_of_week"/>
                </calendar>
            </field>
        </record>

        <!-- Timetable Action -->
        <record id="action_timetable" model="ir.actions.act_window">
            <field name="name">Timetable</field>
            <field name="res_model">school.timetable</field>
            <field name="view_mode">list,form,calendar</field>
        </record>

        <!-- Timetable Menus -->
        <menuitem id="menu_timetable_root" name="Timetable" parent="menu_school_management_root" sequence="35"/>
        <menuitem id="menu_timetable" name="Class Timetable" parent="menu_timetable_root" action="action_timetable" sequence="10"/>

    </data>
</odoo>
