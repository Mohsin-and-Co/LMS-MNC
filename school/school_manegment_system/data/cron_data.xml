<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action for Staff Head Summary -->
        <record id="ir_cron_staff_head_summary" model="ir.cron">
            <field name="name">Staff Head Daily Summary</field>
            <field name="model_id" ref="base.model_ir_model"/>
            <field name="state">code</field>
            <field name="code">model = env['school.staff.head']
model.send_daily_summary_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Scheduled Action for Classwise Attendance Summary -->
        <record id="ir_cron_classwise_attendance_summary" model="ir.cron">
            <field name="name">Classwise Attendance Daily Summary</field>
            <field name="model_id" ref="base.model_ir_model"/>
            <field name="state">code</field>
            <field name="code">model = env['school.attendance.whatsapp.wizard']
model.send_daily_classwise_summary()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Scheduled Action for Sending Queued Attendance Messages -->
        <record id="ir_cron_attendance_message_queue" model="ir.cron">
            <field name="name">Send Queued Attendance Messages</field>
            <field name="model_id" ref="base.model_ir_model"/>
            <field name="state">code</field>
            <field name="code">model = env['school.attendance.message.queue']
model.send_pending_messages()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Scheduled Action for Sending Absent/Leave Student Messages -->
        <record id="ir_cron_absent_leave_messages" model="ir.cron">
            <field name="name">Send Absent/Leave Student Messages</field>
            <field name="model_id" ref="base.model_ir_model"/>
            <field name="state">code</field>
            <field name="code">model = env['school.attendance']
model.send_absent_leave_messages()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
