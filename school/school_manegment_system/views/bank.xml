<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- list View -->
        <record id="view_school_bank_list" model="ir.ui.view">
            <field name="name">school.bank.list</field>
            <field name="model">school.bank</field>
            <field name="arch" type="xml">
                <list string="Bank">
                    <field name="name"/>
                    <field name="account_number"/>
                </list>
            </field>
        </record>

        <record id="view_school_teacher_bank_list" model="ir.ui.view">
            <field name="name">school.teacher.bank.list</field>
            <field name="model">school.teacher.bank</field>
            <field name="arch" type="xml">
                <list string="Teacher Bank">
                    <field name="teacher_id"/>
                    <field name="bank_id"/>
                    <field name="account_number"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_school_bank_form" model="ir.ui.view">
            <field name="name">school.bank.form</field>
            <field name="model">school.bank</field>
            <field name="arch" type="xml">
                <form string="Bank">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="account_number"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_school_teacher_bank_form" model="ir.ui.view">
            <field name="name">school.teacher.bank.form</field>
            <field name="model">school.teacher.bank</field>
            <field name="arch" type="xml">
                <form string="Teacher Bank">
                    <sheet>
                        <group>
                            <field name="teacher_id"/>
                            <field name="bank_id"/>
                            <field name="account_number"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_bank" model="ir.actions.act_window">
            <field name="name">Bank</field>
            <field name="res_model">school.bank</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first bank record!
                </p>
            </field>
        </record>

        <record id="action_teacher_bank" model="ir.actions.act_window">
            <field name="name">Teacher Bank</field>
            <field name="res_model">school.teacher.bank</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first teacher bank record!
                </p>
            </field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_school_settings_root"
                  name="Settings"
                  parent="menu_school_management_root"
                  sequence="100"/>

        <menuitem id="menu_settings_bank"
                  name="Bank"
                  parent="menu_school_settings_root"
                  action="action_bank"
                  sequence="70"/>

    </data>
</odoo>
