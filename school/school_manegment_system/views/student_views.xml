<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Student List View -->
        <record id="view_student_list" model="ir.ui.view">
            <field name="name">school.student.list</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <list string="Students"
                      decoration-info="state == 'draft'"
                      decoration-success="state == 'admitted'"
                      decoration-muted="state == 'left'">
                    <field name="name"/>
                    <field name="roll_number"/>
                    <field name="admission_number"/>
                    <field name="class_id"/>
                    <field name="class_display" string="Class Info"/>
                    <field name="parent_name"/>
                    <field name="parent_phone"/>
                    <field name="phone"/>
                    <field name="state" widget="badge" decoration-success="state == 'admitted'" decoration-info="state == 'draft'" decoration-muted="state == 'left'"/>
                    <field name="attendance_count"/>
                    <field name="fee_count"/>
                </list>
            </field>
        </record>

        <!-- Student Form View -->
        <record id="view_student_form" model="ir.ui.view">
            <field name="name">school.student.form</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <form string="Student">
                    <header>
                        <button name="action_admit"
                                string="Admit"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <button name="action_leave"
                                string="Leave"
                                type="object"
                                invisible="state != 'admitted'"/>
                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="draft,admitted,left"/>
                        <button name="action_open_qr_scanner"
                                string="Open QR Scanner"
                                type="object"
                                class="btn-secondary"
                                icon="fa-qrcode"/>
                        <button name="action_regenerate_qr_code"
                                string="Generate QR Code"
                                type="object"
                                class="btn-secondary"
                                icon="fa-qrcode"/>
                        <button name="action_print_id_card"
                                string="Print ID Card"
                                type="object"
                                class="oe_highlight"
                                icon="fa-print"
                                invisible="state != 'admitted'"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Student Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="photo" widget="image" style="max-width: 200px; max-height: 200px;"/>
                            </group>
                            <group>
                                <field name="roll_number"/>
                                <field name="admission_number" readonly="1"/>
                                <field name="class_id"/>
                                <field name="class_display" string="Class Info" readonly="1" 
                                       help="Current Class: Name - Section - Year"/>
                                <field name="date_of_birth"/>
                                <field name="gender"/>
                                <field name="blood_group"/>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="address" placeholder="Address"/>
                                <field name="admission_date"/>
                                <field name="leaving_date" invisible="state != 'left'"/>
                            </group>
                        </group>
                        <group>
                            <group string="Parent/Guardian Information">
                                <field name="parent_name"/>
                                <field name="parent_phone"/>
                                <field name="parent_email"/>
                                <field name="partner_id" options="{'no_create': True}" help="Link portal user to view this student's results at /school/my/results"/>
                            </group>
                            <group string="QR Code Information">
                                <field name="qr_code" readonly="1"/>
                                <field name="qr_code_image" widget="image" readonly="1" style="max-width: 200px; max-height: 200px;"/>
                                <field name="qr_code_url" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Class History" name="class_history">
                                <field name="class_display" readonly="1"/>
                                <field name="all_class_ids" widget="many2many_tags" readonly="1" 
                                       options="{'no_create': True, 'no_create_edit': True}"
                                       help="All classes this student has been enrolled in"/>
                                <field name="class_history_ids" context="{'default_student_id': id}" 
                                       view_ref="view_student_class_history_tree"/>
                            </page>
                            <page string="Subjects" name="subjects">
                                <field name="subject_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                            </page>
                            <page string="Attendance History" name="attendance">
                                <field name="attendance_ids" context="{'default_student_id': id}">
                                    <list>
                                        <field name="name"/>
                                        <field name="date"/>
                                        <field name="status" widget="badge" decoration-success="status == 'present'" decoration-warning="status == 'late'" decoration-danger="status == 'absent'"/>
                                        <field name="remark"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Fee History" name="fee">
                                <field name="fee_ids" context="{'default_student_id': id}">
                                    <list>
                                        <field name="name"/>
                                        <field name="due_date"/>
                                        <field name="amount"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">

                    </div>
                </form>
            </field>
        </record>

        <!-- Student Class History Tree View -->
        <record id="view_student_class_history_tree" model="ir.ui.view">
            <field name="name">school.student.class.history.tree</field>
            <field name="model">school.student.class.history</field>
            <field name="arch" type="xml">
                <list string="Class History" decoration-success="is_current == True">
                    <field name="class_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="class_name" readonly="1"/>
                    <field name="class_section" readonly="1"/>
                    <field name="class_year" readonly="1"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="is_current" widget="boolean_toggle"/>
                    <field name="notes"/>
                </list>
            </field>
        </record>

        <!-- Student Search View -->


        <!-- Student Action -->
        <record id="action_student" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">school.student</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first student!
                </p>
            </field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_student_root"
                  name="Students"
                  parent="menu_school_management_root"
                  action="action_student"
                  sequence="20"/>

    </data>
</odoo>
