<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Fee list View -->
        <record id="view_fee_list" model="ir.ui.view">
            <field name="name">school.fee.list</field>
            <field name="model">school.fee</field>
            <field name="arch" type="xml">
                <list string="Fees" decoration-info="state == 'draft'" decoration-warning="state == 'pending'" decoration-success="state == 'paid'" decoration-danger="state == 'overdue'">
                    <field name="name"/>
                    <field name="roll_number"/>
                    <field name="student_id"/>
                    <field name="class_id"/>
                    <field name="fee_type"/>
                    <field name="amount"/>
                    <field name="due_date"/>
                    <field name="payment_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Fee Form View -->
        <record id="view_fee_form" model="ir.ui.view">
            <field name="name">school.fee.form</field>
            <field name="model">school.fee</field>
            <field name="arch" type="xml">
                <form string="Fee">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_pay" string="Mark as Paid" type="object" class="btn btn-success" invisible="state not in ['pending', 'overdue']"/>
                        <button name="action_overdue" string="Mark as Overdue" type="object" class="btn btn-danger" invisible="state != 'pending'"/>
                        <button name="action_print_fee" type="object" string="Print Fee" class="btn-primary"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,pending,paid,overdue"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Fee Reference"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="roll_number"/>
                                <field name="student_id"/>
                                <field name="class_id"/>
                                <field name="fee_type"/>
                                <field name="amount"/>
                            </group>
                            <group>
                                <field name="invoice_id"/>
                                <field name="due_date"/>
                                <field name="bank_id"/>
                                <field name="invoice_state"/>
                                <field name="payment_date" invisible="state != 'paid'"/>
                                <field name="payment_reference" invisible="state != 'paid'"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Fee Action -->
        <record id="action_fee" model="ir.actions.act_window">
            <field name="name">Fees</field>
            <field name="res_model">school.fee</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first fee record!
                </p>
            </field>
        </record>

        <!-- Menus -->

        <menuitem id="menu_settings_fees"
                  name="Fees"
                  parent="menu_school_settings_root"
                  action="action_fee"
                  sequence="50"/>

    </data>
</odoo>
