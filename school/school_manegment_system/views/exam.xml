<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- list View -->
        <record id="view_school_exam_list" model="ir.ui.view">
            <field name="name">school.exam.list</field>
            <field name="model">school.exam</field>
            <field name="arch" type="xml">
                <list string="Exams">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_school_exam_form" model="ir.ui.view">
            <field name="name">school.exam.form</field>
            <field name="model">school.exam</field>
            <field name="arch" type="xml">
                <form string="Exam">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_exam" model="ir.actions.act_window">
            <field name="name">Exams</field>
            <field name="res_model">school.exam</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first exam record!
                </p>
            </field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_settings_exam"
                  name="Exam"
                  parent="menu_school_settings_root"
                  action="action_exam"
                  sequence="80"/>

    </data>
</odoo>
