        <!-- /school/scan - Public QR scan page -->
        <template id="school_scan_page" name="Scan Attendance - School">
            <t t-call="school_manegment_system.school_layout">
                <div style="max-width: 800px; margin: 100px auto 60px; padding: 20px;">
                    <h1 style="color: #1a4f7c; margin-bottom: 10px;">
                        <i class="fa fa-qrcode"/> QR Attendance Scan
                    </h1>
                    <p style="color: #666; margin-bottom: 25px;">Scan student QR code to mark attendance. Camera will start automatically.</p>
                    <div class="card shadow" style="border-radius: 10px; overflow: hidden;">
                        <div style="background: #1a4f7c; color: white; padding: 15px;">
                            <h4 style="margin: 0;"><i class="fa fa-camera"/> Camera Scanner</h4>
                        </div>
                        <div style="padding: 20px; text-align: center;">
                            <div id="scan-area" style="margin: 15px 0;">
                                <video id="qr-video" width="100%" style="max-width: 500px; border-radius: 8px; background: #000; display: none;" playsinline="true"></video>
                                <canvas id="qr-canvas" style="display: none;"></canvas>
                                <div id="scan-placeholder" style="padding: 40px; background: #f5f5f5; border: 2px dashed #ddd; border-radius: 8px;">
                                    <i class="fa fa-camera" style="font-size: 48px; color: #999; margin-bottom: 10px;"></i>
                                    <p style="color: #666; margin: 0;">Camera will start automatically</p>
                                </div>
                            </div>
                            <p id="scan-status" style="margin: 10px 0; color: #007cba;">Position QR code in front of camera</p>
                            <div style="margin: 15px 0;">
                                <button type="button" id="btn-start-cam" class="btn btn-primary"><i class="fa fa-play"/> Start Camera</button>
                                <button type="button" id="btn-stop-cam" class="btn btn-danger" style="display: none;"><i class="fa fa-stop"/> Stop Camera</button>
                            </div>
                            <div id="scan-result" style="margin-top: 15px; display: none;"></div>
                        </div>
                    </div>
                    <div style="margin-top: 20px; text-align: center;">
                    </div>
                </div>
                <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
                <script>
                    (function() {
                        var video = document.getElementById('qr-video');
                        var canvas = document.getElementById('qr-canvas');
                        var ctx = canvas.getContext('2d');
                        var placeholder = document.getElementById('scan-placeholder');
                        var statusEl = document.getElementById('scan-status');
                        var resultEl = document.getElementById('scan-result');
                        var btnStart = document.getElementById('btn-start-cam');
                        var btnStop = document.getElementById('btn-stop-cam');
                        var stream = null;
                        var scanning = false;
                        var lastCode = '';
                        var lastSendTime = 0;
                        function startCam() {
                            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                                statusEl.textContent = 'Camera not supported in this browser.';
                                return;
                            }
                            navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
                                .then(function(mediaStream) {
                                    stream = mediaStream;
                                    video.srcObject = stream;
                                    video.setAttribute('playsinline', true);
                                    video.play();
                                    video.style.display = 'block';
                                    if (placeholder) placeholder.style.display = 'none';
                                    btnStart.style.display = 'none';
                                    btnStop.style.display = 'inline-block';
                                    statusEl.textContent = 'Scanning... Position QR code in front of camera';
                                    scanning = true;
                                    requestAnimationFrame(scanLoop);
                                })
                                .catch(function(err) {
                                    statusEl.textContent = 'Camera error: ' + (err.message || 'Access denied');
                                });
                        }
                        function stopCam() {
                            scanning = false;
                            if (stream) { stream.getTracks().forEach(function(t){ t.stop(); }); stream = null; }
                            video.srcObject = null;
                            video.style.display = 'none';
                            if (placeholder) placeholder.style.display = 'block';
                            btnStart.style.display = 'inline-block';
                            btnStop.style.display = 'none';
                            statusEl.textContent = 'Camera stopped';
                        }
                        function scanLoop() {
                            if (!scanning || !video || !ctx) return;
                            if (video.readyState === video.HAVE_ENOUGH_DATA &amp;&amp; typeof jsQR !== 'undefined') {
                                canvas.width = video.videoWidth;
                                canvas.height = video.videoHeight;
                                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                                var data = ctx.getImageData(0, 0, canvas.width, canvas.height);
                                var code = jsQR(data.data, data.width, data.height);
                                if (code &amp;&amp;  code.data) {
                                    var now = Date.now();
                                    if (code.data !== lastCode || (now - lastSendTime) > 3000) {
                                        lastCode = code.data;
                                        lastSendTime = now;
                                        statusEl.textContent = 'Detected: ' + code.data + ' - Submitting...';
                                        submitScan(code.data);
                                    }
                                }
                            }
                            requestAnimationFrame(scanLoop);
                        }
                        function submitScan(qrCode) {
                            resultEl.style.display = 'block';
                            resultEl.innerHTML = '<span style="color: #888;">Submitting...</span>';
                            var rpc = '/school/scan/submit';
                            var payload = { qr_code: qrCode, date: new Date().toISOString().slice(0,10) };
                            fetch(rpc, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(payload)
                            }).then(function(r) { return r.json(); })
                            .then(function(data) {
                                var res = data.result || data;
                                if (res &amp;&amp;  res.success) {
                                    resultEl.innerHTML = '<span style="color: green;"><strong>' + (res.message || 'Success') + '</strong></span>';
                                    statusEl.textContent = 'Success! Scan next QR code.';
                                } else {
                                    resultEl.innerHTML = '<span style="color: red;">' + (res.message || 'Error') + '</span>';
                                    statusEl.textContent = res.message || 'Error';
                                }
                            }).catch(function(e) {
                                resultEl.innerHTML = '<span style="color: red;">Request failed. Try again.</span>';
                                statusEl.textContent = 'Request failed.';
                            });
                        }
                        btnStart.addEventListener('click', startCam);
                        btnStop.addEventListener('click', stopCam);
                        if (typeof $ !== 'undefined') {
                            $(document).ready(function() { setTimeout(startCam, 500); });
                        } else {
                            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function() { setTimeout(startCam, 500); });
                            else setTimeout(startCam, 500);
                        }
                    })();
                        </script>
            </t>
        </template>

        <!-- Portal: My Results - relative result per student only -->
        <template id="portal_my_results" name="My Results">
            <t t-call="website.layout">
                <t t-set="additional_title" t-value="'My Results'"/>
                <div id="wrap" class="oe_structure">
                    <div class="container mt-4 mb-4">
                        <h1 class="mb-4"><i class="fa fa-graduation-cap"/> My Results</h1>
                        <p class="text-muted" t-if="not results">No results found for your linked student(s).</p>
                        <t t-if="not students">
                            <div class="alert alert-warning">
                                <p><strong>No students linked to your account.</strong></p>
                                <p>Please contact the school administrator to link your email (<t t-esc="user_email or 'N/A'"/>) or partner account to your student record.</p>
                                <p>Your Partner ID: <t t-esc="user_partner_id or 'N/A'"/></p>
                            </div>
                        </t>
                        <t t-if="results">
                            <t t-foreach="results" t-as="res">
                                <div class="card mb-4 shadow-sm">
                                    <div class="card-header" style="background-color: #1a4f7c; color: white;">
                                        <strong t-out="res.student_id.name or 'N/A'"/> —
                                        <t t-if="res.exam_id" t-out="res.exam_id.name"/> —
                                        <t t-out="res.date"/>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-4"><strong>Class:</strong> <t t-out="res.class_id.name or '-'"/></div>
                                            <div class="col-md-4"><strong>Total:</strong> <t t-out="res.obtained_marks"/> / <t t-out="res.total_marks"/></div>
                                            <div class="col-md-4"><strong>Percentage:</strong> <t t-out="'%.1f' % res.percentage"/>% — Grade <t t-out="res.grade"/>
                                            </div>
                                        </div>
                                        <table class="table table-sm table-bordered">
                                            <thead><tr><th>Subject</th><th>Obtained</th><th>Max</th></tr></thead>
                                            <tbody>
                                                <t t-foreach="res.line_ids" t-as="line">
                                                    <tr>
                                                        <td t-out="line.subject_id.name"/>
                                                        <td t-out="line.obtained_marks"/>
                                                        <td t-out="line.subject_id.max_marks"/>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <t t-if="students and not results">
                            <div class="alert alert-info">
                                <p>No results found for your linked student(s).</p>
                            </div>
                        </t>
                        <div class="mt-3">
                            <a href="/my" class="btn btn-primary ms-2">My Portal</a>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>